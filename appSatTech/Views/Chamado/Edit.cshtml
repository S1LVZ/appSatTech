@model appSatTech.Models.Chamado

@{
    ViewData["Title"] = "Edit Chamado";
}

<div class="page-heading"><div><h1>Editar chamado</h1><p>Atualize as informações abaixo.</p></div></div>
<div class="form-card">
    <div class="col-lg-8">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Codigo" />
            <div class="form-group">
                <label asp-for="DataHora" class="control-label"></label>
                <input asp-for="DataHora" class="form-control" />
                <span asp-validation-for="DataHora" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StatusAtendimento" class="control-label"></label>
                <input asp-for="StatusAtendimento" class="form-control" />
                <span asp-validation-for="StatusAtendimento" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ClienteId" class="control-label"></label>
                <select asp-for="ClienteId" class="form-control" asp-items="ViewBag.ClienteId"></select>
                <span asp-validation-for="ClienteId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TecnicoId" class="control-label"></label>
                <select asp-for="TecnicoId" class="form-control" asp-items="ViewBag.TecnicoId"></select>
                <span asp-validation-for="TecnicoId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Salvar alterações" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Voltar para lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
