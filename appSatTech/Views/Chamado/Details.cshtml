@model appSatTech.Models.Chamado

@{
    ViewData["Title"] = "Details Chamado";
}

<div class="page-heading"><div><h1>Detalhes chamado</h1><p>Confira as informações cadastradas.</p></div></div>
<div class="details-card">
    <h4>Chamado</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.DataHora)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.DataHora)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.StatusAtendimento)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.StatusAtendimento)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Cliente)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Cliente.Codigo)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Tecnico)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Tecnico.Codigo)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.Codigo">Editar</a> |
    <a asp-action="Index">Voltar para lista</a>
</div>
