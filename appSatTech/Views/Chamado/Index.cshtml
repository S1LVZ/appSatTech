@model IEnumerable<appSatTech.Models.Chamado>
@{
    ViewData["Title"] = "Chamados";
}
<div class="page-heading">
    <div>
        <h1>Meus chamados</h1>
        <p>Acompanhe e organize suas solicitações de suporte.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">＋ Novo chamado</a>
</div>
<div class="table-card">
    <table class="table">
        <thead><tr>
            <th>@Html.DisplayNameFor(model => model.DataHora)</th>
            <th>@Html.DisplayNameFor(model => model.StatusAtendimento)</th>
            <th>@Html.DisplayNameFor(model => model.Cliente)</th>
            <th>@Html.DisplayNameFor(model => model.Tecnico)</th>
            <th>Ações</th>
        </tr></thead>
        <tbody>
        @foreach (var item in Model) {
            <tr>
                <td><strong>@Html.DisplayFor(modelItem => item.DataHora)</strong></td>
                <td><span class="status-pill">@Html.DisplayFor(modelItem => item.StatusAtendimento)</span></td>
                <td>@Html.DisplayFor(modelItem => item.Cliente.Codigo)</td>
                <td>@Html.DisplayFor(modelItem => item.Tecnico.Codigo)</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Codigo">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.Codigo">Ver</a>
                    <a asp-action="Delete" asp-route-id="@item.Codigo">Excluir</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
